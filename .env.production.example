# ==============================================================================
# stock-bot 生产部署 · compose 插值模板
# ==============================================================================
# 用法（服务器仓库根目录）：
#
#   cp .env.production.example .env
#   # 按下面 ① ② 生成密钥、填域名与口令
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml config \
#     | grep -E "APP_ENV|COOKIE_SECURE|INTERNAL_API_TOKEN|JWT_PRIVATE_KEY_PEM|TRUST_FORWARDED_FOR|RABBITMQ_DEFAULT_USER"
#
# 只放**本文件真正被 compose `${VAR}` 插值消费**的键（清单见每节注释）。
# 其余位置见文末「其他配置放哪里」。
#
# ⚠️ 本文件的键缺失时 compose 会静默回落到 docker-compose.yml 里的开发默认值
#    （APP_ENV=development、空 JWT 私钥、空 INTERNAL_API_TOKEN），**不报任何错**。
# ==============================================================================

# ------------------------------------------------------------------------------
# ① 运行环境（auth-service 读这里；api/worker/scheduler 读 backend/.env，两处都要设）
# ------------------------------------------------------------------------------
# production 时 auth-service 启动强校验：要求 AUTH_COOKIE_SECURE=true（配合 HTTPS），
# 否则 fail-fast 拒绝启动 —— 这是防止"生产跑在开发鉴权模式"的最后一道闸。
APP_ENV=production

# ------------------------------------------------------------------------------
# ② JWT / 内部调用凭据（必改，否则生产鉴权形同虚设）
# ------------------------------------------------------------------------------
# 生成密钥对（两端必须同源配对）：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# 再按下面"单行 + 转义换行"格式粘进来（\n 会被 compose 还原成真实换行，已实测）：
#   awk 'BEGIN{ORS="\\n"}{print}' private.pem
AUTH_JWT_PRIVATE_KEY_PEM="<CHANGE_ME: 用上一步生成的私钥，单行 + \n 转义>"
AUTH_JWT_PUBLIC_KEY_PEM="<CHANGE_ME: 用上一步生成的公钥，单行 + \n 转义>"

# 签发者/受众契约：api 侧（AUTH_ISSUER/AUTH_AUDIENCE）必须与这里一致，别单方面改
JWT_ISSUER=stock-bot-auth
JWT_AUDIENCE=urn:stock-bot:api

# forward-auth → auth-service 的内部调用凭据（X-Internal-Token）。
# 生成：openssl rand -hex 32。留空/过弱 = 任何能访问内网 8001 的人都可冒充网关注入断言。
INTERNAL_API_TOKEN=<CHANGE_ME: openssl rand -hex 32>

# 断言缓存秒数（forward-auth 侧；默认 25，无需改）
ASSERTION_CACHE_TTL=25

# ------------------------------------------------------------------------------
# ③ Cookie / 代理（HTTPS 上线前必看）
# ------------------------------------------------------------------------------
# Session/CSRF Cookie 是否仅经 HTTPS 传输：生产必须 true（配合真实 HTTPS 入口）
AUTH_COOKIE_SECURE=true

# 是否信任 X-Forwarded-For 解析真实客户端 IP。
# 本栈 Traefik 在最前面 → 保持 true；若把 auth-service 直接暴露/本地直连，必须 false，
# 否则客户端可伪造该头污染审计日志里的来源 IP。
AUTH_TRUST_FORWARDED_FOR=true

# ------------------------------------------------------------------------------
# ④ 边缘层（Caddy：TLS 自动签发 + 反代到 Traefik；见 gateway/Caddyfile 与 docker-compose.prod.yml）
# ------------------------------------------------------------------------------
# 站点域名（Caddy 用它申请证书；DNS 必须已有 A 记录指向本服务器，且 80 端口可从公网访问以走 HTTP-01 挑战）
QSTOCK_DOMAIN=qstock.tsingyen.site

# 证书到期/吊销通知邮箱（可选；留空 = 匿名注册 ACME 账号，仍能正常签发与续期）。
# 设了之后还要在 gateway/Caddyfile 里启用 `email {$ACME_EMAIL}` 那一行。
ACME_EMAIL=

# ------------------------------------------------------------------------------
# ⑤ RabbitMQ 凭据（默认 stockbot/stockbot_pass 仅供本地联调）
# ------------------------------------------------------------------------------
# 改这两个值时注意：api/worker/scheduler 的 RABBITMQ_URL 由 compose 用它们拼装；
# 已有 rabbitmq_data 卷的旧部署改口令需重建该卷（在途任务会丢，需重发）。
RABBITMQ_DEFAULT_USER=stockbot
RABBITMQ_DEFAULT_PASS=<CHANGE_ME: 强口令>

# ==============================================================================
# 上线前自证（三条都必须给出期望值，任一为空/development 就先别上线）
# ==============================================================================
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml config \
#     | grep -E "APP_ENV|COOKIE_SECURE|INTERNAL_API_TOKEN|JWT_PRIVATE_KEY_PEM|TRUST_FORWARDED_FOR|RABBITMQ_DEFAULT_USER"
#   docker exec auth_service sh -c 'for v in APP_ENV COOKIE_SECURE TRUST_FORWARDED_FOR INTERNAL_API_TOKEN JWT_PRIVATE_KEY_PEM JWT_PUBLIC_KEY_PEM; do eval "val=\$$v"; echo "$v=${val:+<set>}"; done'
#   docker exec backend_api sh -c 'echo "APP_ENV=$APP_ENV TUSHARE_TOKEN=${TUSHARE_TOKEN:+<set>} CORS_ORIGINS=$CORS_ORIGINS"'
#
# 注意容器内键名与宿主侧不同：AUTH_JWT_PRIVATE_KEY_PEM→JWT_PRIVATE_KEY_PEM、
# AUTH_COOKIE_SECURE→COOKIE_SECURE、AUTH_TRUST_FORWARDED_FOR→TRUST_FORWARDED_FOR。
#
# ==============================================================================
# TLS / 生产模式（本文件 + Caddy 一起决定）
# ==============================================================================
# 证书由边缘的 Caddy 自动签发续期（不需要手工 certbot，也不在 Traefik 里配 ACME）。
# 证书与 ACME 账号存在 compose 卷 `stock-bot_caddy_data` 里 —— **不要删**，
# 丢失会触发重新签发（Let's Encrypt 有每周同域名重复签发上限）。
#
# 上线检查顺序：
#   1) DNS：`dig +short $QSTOCK_DOMAIN` 指向本机公网 IP
#   2) 安全组/防火墙放行 80 与 443；80 必须开着（HTTP-01 挑战 + 跳转）
#   3) `docker compose ... up -d caddy` 后看日志：`docker logs caddy | grep -i "certificate obtained"`
#   4) HTTPS 通了以后：把本文件 APP_ENV 改成 production、AUTH_COOKIE_SECURE 改成 true，
#      并把 backend/.env 的 APP_ENV 与 CORS_ORIGINS 一起改成 https://$QSTOCK_DOMAIN，然后
#      `docker compose ... up -d --force-recreate auth-service api worker scheduler`
#      （auth-service 在 production 下会强校验 AUTH_COOKIE_SECURE=true，配错会直接拒绝启动 —— 这是有意的）
#   5) 复核：`curl -sI https://$QSTOCK_DOMAIN/api/v1/concepts?limit=1 | head -1` 与
#      `docker exec auth_service sh -c 'echo $APP_ENV $COOKIE_SECURE'`
#
# ==============================================================================
# 其他配置放哪里（本文件不含，写在这里也没用）
# ==============================================================================
# | 要配的东西 | 去哪配 |
# |-----------|--------|
# | TUSHARE_TOKEN / INDUSTRY_DATA_SOURCE / CORS_ORIGINS / APP_ENV(业务侧) | `backend/.env`（见 backend/.env.production.example） |
# | PostgreSQL 口令（stock_user/stock_pass、auth_user/auth_pass） | **硬编码在 `docker-compose.yml`**（postgres / auth-db 服务的 `POSTGRESQL_*`，以及 api/worker/scheduler/migrate 的 `DATABASE_URL`）。本文件里的 `POSTGRES_*` 不会被消费 —— 要改口令得同时改这些行，或另开一轮把 compose 改成插值 |
# | 端口 | 对外只有 **caddy** 的 80/443（生产走 `docker-compose.prod.yml`）；gateway 在服务器上不绑宿主机端口；postgres/redis 只绑 `127.0.0.1`（5433/6380）。本地开发由 base compose 的 gateway `80:80` 提供 |
# | 网关/限流/安全头 | `gateway/traefik.yml` + `gateway/dynamic/*.yml` |
# | 调度/采集窗口等业务开关 | `backend/.env` 或代码默认值 |

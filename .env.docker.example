# ==============================================================================
# stock_bot Docker Compose Environment Configuration Template
# ==============================================================================

# Application Environment
# 默认 development；生产部署改为 production（要求 HTTPS 且 AUTH_COOKIE_SECURE=true，
# 否则 auth-service 启动时 fail-fast 拒绝）
APP_ENV=development
APP_DEBUG=false

# ------------------------------------------------------------------------------
# Databases (PostgreSQL)
# ------------------------------------------------------------------------------
# Stock API Database
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_pass
POSTGRES_DB=stock_bot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://stock_user:stock_pass@postgres:5432/stock_bot

# Auth Service Database
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_pass
AUTH_POSTGRES_DB=stock_bot_auth
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@auth-db:5432/stock_bot_auth

# ------------------------------------------------------------------------------
# Caching & Session Storage (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Message Broker (RabbitMQ)
# ------------------------------------------------------------------------------
# 生产必改：默认凭据 stockbot/stockbot_pass 仅供本地 compose 联调，
# 生产部署必须更换强口令（AMQP 5672 与管理 UI 15672 均未映射宿主机，仅内网可达）
RABBITMQ_DEFAULT_USER=stockbot
RABBITMQ_DEFAULT_PASS=stockbot_pass
RABBITMQ_URL=amqp://stockbot:stockbot_pass@rabbitmq:5672/
RABBITMQ_EXCHANGE=stock_bot.topic

# ------------------------------------------------------------------------------
# API Gateway & Ports
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
# Traefik dashboard 不再映射宿主机端口（仅内网可达）；此变量仅留存备注，
# 需要时通过 docker exec 或临时端口转发按需映射，勿长期对外暴露
GATEWAY_DASHBOARD_PORT=8080

# ------------------------------------------------------------------------------
# Security & Auth Service Settings
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=stockbot_session
CSRF_COOKIE_NAME=stockbot_csrf
SESSION_TTL=86400
ASSERTION_TTL=60
JWT_ISSUER=stock-bot-auth
JWT_AUDIENCE=urn:stock-bot:api
JWT_KID=auth-key-2026-01
JWT_ALGORITHM=RS256

# Internal service-to-service token used by forward-auth -> auth-service calls
# (X-Internal-Token). Required in production; empty in dev = header not sent.
INTERNAL_API_TOKEN=

# Auth Service JWT 签名密钥持久化（PKCS#8 PEM，含真实换行的多行值）
# 生产必填——用 `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048` 生成私钥，
# 再 `openssl pkey -in private.pem -pubout` 导出公钥（两端密钥需同源配对）；
# 留空则开发模式启动时自动生成 RSA 密钥对（重启轮换会使已签发断言失效）。
AUTH_JWT_PRIVATE_KEY_PEM=
AUTH_JWT_PUBLIC_KEY_PEM=

# Session/CSRF Cookie 是否仅经 HTTPS 传输。
# 生产必须 true（配合 HTTPS）；APP_ENV=production 时 auth-service 启动强校验此项。
AUTH_COOKIE_SECURE=false

# auth-service 是否信任 X-Forwarded-For 解析真实客户端 IP。
# compose 部署形态（Traefik 网关在前）置 true；auth-service 直接暴露/本地直连时必须 false，
# 否则客户端可伪造该头污染审计日志中的来源 IP。
AUTH_TRUST_FORWARDED_FOR=true

# CORS
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

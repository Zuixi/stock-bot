# ==============================================================================
# stock_bot Docker Compose Environment Configuration Template
# ==============================================================================

# Application Environment
APP_ENV=production
APP_DEBUG=false

# ------------------------------------------------------------------------------
# Databases (PostgreSQL)
# ------------------------------------------------------------------------------
# Stock API Database
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_pass
POSTGRES_DB=stock_bot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://stock_user:stock_pass@postgres:5432/stock_bot

# Auth Service Database
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_pass
AUTH_POSTGRES_DB=stock_bot_auth
AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@auth-db:5432/stock_bot_auth

# ------------------------------------------------------------------------------
# Caching & Session Storage (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Message Broker (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=stock_bot.topic

# ------------------------------------------------------------------------------
# API Gateway & Ports
# ------------------------------------------------------------------------------
GATEWAY_HTTP_PORT=80
GATEWAY_DASHBOARD_PORT=8080

# ------------------------------------------------------------------------------
# Security & Auth Service Settings
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=stockbot_session
CSRF_COOKIE_NAME=stockbot_csrf
SESSION_TTL=86400
ASSERTION_TTL=60
JWT_ISSUER=stock-auth-service
JWT_AUDIENCE=stock-api
JWT_KID=auth-key-2026-01
JWT_ALGORITHM=RS256

# CORS
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:8080

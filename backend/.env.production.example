# ==============================================================================
# stock-bot 生产部署 · 后端运行时 env（复制为 backend/.env）
# ==============================================================================
# 用法：
#   cp backend/.env.production.example backend/.env
#   # 填 TUSHARE_TOKEN 与生产域名
#
# 谁读它：api / worker / scheduler 容器（docker-compose.yml 的 `env_file: ./backend/.env`），
#        以及本机 `uv run` 直起后端时。
# 不读它：auth-service / forward-auth / nginx —— 那些走根目录 `.env`（见 .env.production.example）。
# ==============================================================================

# ------------------------------------------------------------------------------
# 必填：TuShare Pro Token（https://tushare.pro）
# ------------------------------------------------------------------------------
# 缺失时 API 启动钩子 data_init 无法回补数据（只在日志里报错，不会让容器起不来）。
# 注意：空库 + 真实 token 首次开机会自动回补近 3 年行情 —— 服务器上先恢复数据再起应用，
# 详见 docs/build.md「服务器部署」的「开机回填 footgun」。
TUSHARE_TOKEN=<CHANGE_ME: 你的 TuShare Pro Token>

# ------------------------------------------------------------------------------
# 运行环境（**与根 .env 的 APP_ENV 保持一致**：auth-service 读根 .env，本容器组只读这里）
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# CORS：生产前端域名（逗号分隔，带协议，不要带结尾斜杠）
# ------------------------------------------------------------------------------
# 前后端同源（都经 Traefik :80/:443）时可留空；一旦前端挂在别的域名/端口就必须显式列出，
# 否则浏览器会拦掉跨域请求。
CORS_ORIGINS=https://<CHANGE_ME: 你的域名>

# ------------------------------------------------------------------------------
# 数据源开关
# ------------------------------------------------------------------------------
# akshare = 行业投研工作台走 akshare 取数（默认，容器内已装 akshare 及其依赖）
INDUSTRY_DATA_SOURCE=akshare

# ------------------------------------------------------------------------------
# 数据库 / 缓存 / 队列
# ------------------------------------------------------------------------------
# 说明：容器部署时这三项**由 docker-compose.yml 的 `environment:` 覆盖**，此处值只在
# 本机 `uv run` 直起后端时生效（那时容器名不解析，要用 localhost + 宿主机映射端口）。
# 之所以仍写全：① 本机直起不报错；② 明确"业务库口令硬编码在 docker-compose.yml"这一事实。
DATABASE_URL=postgresql+asyncpg://stock_user:stock_pass@postgres:5432/stock_bot
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://stockbot:stockbot_pass@rabbitmq:5672/
RABBITMQ_EXCHANGE=stock_bot.topic

# 连接池（默认 10/20 足够单机部署；并发大再调）
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_DEFAULT_TTL=300

# ==============================================================================
# 自证（起完 api 后跑；TUSHARE_TOKEN 必须 <set>）
# ==============================================================================
#   docker exec backend_api sh -c 'echo "APP_ENV=$APP_ENV TUSHARE_TOKEN=${TUSHARE_TOKEN:+<set>} CORS_ORIGINS=$CORS_ORIGINS"'
#   docker exec backend_api python -c "import urllib.request,json;print(json.load(urllib.request.urlopen('http://localhost:8000/health')))"
#     → 期望包含 {"status":"ok","env":"production","version":...,"commit":...}

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://stock_user:stock_pass@localhost:5432/stock_bot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://stockbot:stockbot_pass@localhost:5672/
RABBITMQ_EXCHANGE=stock_bot.topic

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
